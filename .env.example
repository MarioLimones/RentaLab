# Configuración exclusiva del backend. Copiar a .env en la raíz.
# La base por defecto es data/rentalab.db (ruta absoluta calculada).
RENTALAB_ENVIRONMENT=development
# Espera máxima para obtener un bloqueo SQLite: 0–60000 ms.
RENTALAB_SQLITE_BUSY_TIMEOUT_MS=5000
# Arranque empaquetado: puerto HTTP interno y puerto publicado por Compose.
RENTALAB_PORT=8000
RENTALAB_HOST_PORT=8000
# Proxies de confianza (IP o lista separada por comas); evita comodines públicos.
RENTALAB_FORWARDED_ALLOW_IPS=127.0.0.1

# Para otra base SQLite, usar una URL SQLAlchemy. En Windows, por ejemplo:
# RENTALAB_DATABASE_URL=sqlite:///C:/ruta/a/RentaLab/data/rentalab.db
# En Docker, si se configura, debe apuntar dentro del volumen /data, por ejemplo:
# RENTALAB_DATABASE_URL=sqlite:////data/rentalab.db
# No reutilizar una URL Windows en el contenedor; usa otro archivo --env-file.

# Solo al servir la compilación React con FastAPI. En desarrollo se usa Vite.
# Debe apuntar a una carpeta que ya contenga index.html y assets/.
# RENTALAB_FRONTEND_DIST=C:/ruta/a/RentaLab/frontend/dist

# Acceso: crea usuarios explícitamente con rentalab.autenticacion.gestionar_usuarios tras migrar.
# No hay contraseña ni secreto compartidos por defecto. Ver docs/ACCESO.md.
# Compatibilidad opcional: conserva ambos valores si ya usabas el operador anterior.
# RENTALAB_OPERATOR_USERNAME=operador
# RENTALAB_OPERATOR_PASSWORD_HASH=
# Generar con secrets.token_urlsafe(48). Mínimo 32 caracteres.
RENTALAB_SESSION_SECRET=
# Caducidad absoluta de la sesión en segundos. La actividad no la prolonga.
RENTALAB_SESSION_TTL_SECONDS=3600

# En producción: RENTALAB_ENVIRONMENT=production y acceso mediante HTTPS.
# La cookie será Secure; el HTTP local sólo corresponde a development/test.
# No añadir secretos a variables VITE_: el navegador puede leerlas.
